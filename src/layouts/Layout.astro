---
import '../styles/global.css';
import bakeryosLogo from '../assets/BakeryOS-logo.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={bakeryosLogo.src} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="BakeryOS is an Arch Linux based distribution shaped for developers who want a fast, focused workstation from the first boot."
    />
    <title>BakeryOS | A better starting point for builders</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
