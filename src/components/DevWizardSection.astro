---
import devWizardScreenshot from '../assets/background_3.png';
---

<section class="dev-wizard-section" id="dev-wizard">
  <div class="section-shell dev-wizard-inner">
    <div class="dev-wizard-copy reveal">
      <p class="eyebrow">BakeryOS Dev Wizard</p>
      <h2>Set up your<br /><em>toolbox in one click.</em></h2>
      <p class="section-copy">
        Choose the tools you need and let BakeryOS handle the setup. Dev Wizard installs editors, languages, frameworks,
        and more without the usual package hunt.
      </p>
      <a class="button dev-wizard-button" href="#download">Explore Dev Wizard <span aria-hidden="true">↗</span></a>
    </div>
    <div class="dev-wizard-preview reveal reveal-delay">
      <div class="dev-wizard-window">
        <img src={devWizardScreenshot.src} alt="BakeryOS Dev Wizard showing one-click developer tool installation" />
      </div>
      <div class="dev-wizard-note">
        <span>✓</span> Pick. Install. Start building.
      </div>
    </div>
  </div>
</section>
