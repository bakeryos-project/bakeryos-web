---
import {
    Monitor,
    Gauge,
    PackageOpen,
    Settings,
    UserGroup,
    ArrowRight,
    ArrowUpRight,
    Download,
    Plus,
} from "@lucide/astro";
import Background1 from "../assets/b-1.png";
---

<section id="experience" class="max-w-6xl mx-auto px-4 py-20 md:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="reveal space-y-6">
            <h2 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
                Every Detail Has
                <span class="text-amber-700"> Its Place.</span>
            </h2>

            <p class="text-gray-600 text-lg leading-relaxed">
                The best desktop experiences don't demand your attention. They
                give you the tools to focus on what matters, while the interface
                feels natural in the background.
            </p>

            <p class="text-gray-600 leading-relaxed">
                BakeryOS brings together its desktop layout, visual styling, and
                system components into an experience designed to feel consistent
                from one interaction to the next.
            </p>

            <!-- <a
                href="/guides"
                class="inline-flex items-center gap-2 font-semibold text-amber-800 hover:text-orange-700 transition-colors shimmer-btn"
            >
                Discover the project
                <ArrowRight />
            </a> -->
        </div>

        <div class="reveal reveal-delay-1 space-y-4 float">
            <div class="rounded-2xl overflow-hidden border border-amber-100 shadow-xl shadow-amber-900/5 pulse-glow">
                <img
                    src={Background1.src}
                    alt="BakeryOS desktop environment preview"
                    loading="lazy"
                    class="w-full h-auto object-cover"
                />
            </div>
        </div>
    </div>
</section>
