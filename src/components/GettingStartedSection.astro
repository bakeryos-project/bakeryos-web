---
import {
    Monitor,
    Gauge,
    PackageOpen,
    Settings,
    UserGroup,
    ArrowRight,
    ArrowUpRight,
    Download,
    Plus,
} from "@lucide/astro";
import Background2 from "../assets/b-2.png";
---

<section id="get-started" class="max-w-6xl mx-auto px-4 py-20 md:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="reveal space-y-6">
            <h2 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
                Your Next Desktop
                <span class="text-amber-700"> Starts Here.</span>
            </h2>

            <p class="text-gray-600 text-lg leading-relaxed">
                Ready to explore BakeryOS? Start with the latest available
                release, review the installation guide, and prepare your system
                before making the switch.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 pt-2">
                <a
                    href="/download"
                    class="inline-flex justify-center items-center gap-2 px-7 py-3.5 rounded-full bg-linear-to-r from-amber-600 to-orange-600 text-white font-semibold shadow-lg shadow-orange-900/10 hover:scale-[1.02] active:scale-[0.98] transition-all shimmer-btn"
                >
                    <Download />
                    Download BakeryOS
                </a>

                <a
                    href="/guides/installation"
                    class="inline-flex justify-center items-center px-7 py-3.5 rounded-full bg-white border border-amber-200 text-gray-700 font-semibold hover:bg-amber-50 transition-colors shimmer-btn"
                >
                    Installation Guide
                </a>
            </div>
        </div>

        <div class="reveal reveal-delay-1 relative float">
            <div class="absolute -inset-4 rounded-3xl bg-linear-to-br from-amber-200/50 to-orange-200/30 blur-2xl"></div>
            <div class="relative rounded-2xl overflow-hidden border border-amber-100 shadow-xl pulse-glow">
                <img
                    src={Background2.src}
                    alt="Discover the BakeryOS desktop"
                    loading="lazy"
                    class="w-full h-auto object-cover"
                />
            </div>
        </div>
    </div>
</section>
